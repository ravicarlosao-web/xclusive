{
  "name": "workspace",
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"@workspace/api-server\" --filter \"@workspace/xclusive\" run dev",
    "dev:all": "pnpm -r --parallel --filter \"@workspace/api-server\" --filter \"@workspace/xclusive\" --filter \"@workspace/admin\" run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/xclusive run dev",
    "dev:admin": "pnpm --filter @workspace/admin run dev",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:push-force": "pnpm --filter @workspace/db run push-force",
    "db:seed": "pnpm --filter @workspace/scripts run seed",
    "db:test": "pnpm --filter @workspace/scripts exec tsx ./src/test-db.ts",
    "build": "pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
