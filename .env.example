# ==============================================================================
# XCLUSIVE - Variáveis de Ambiente
# ==============================================================================

# ------------------------------------------------------------------------------
# BASE DE DADOS (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Cole aqui a connection string da sua branch do Neon (neon.tech)
# Exemplo: postgresql://neondb_owner:npg_xyz@ep-fancy-star-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-your-branch-id.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# AUTENTICAÇÃO E SEGURANÇA
# ------------------------------------------------------------------------------
SESSION_SECRET=xclusive_super_secret_jwt_key_local_dev_2026
ALLOWED_ORIGINS=http://localhost:19285,http://localhost:23744,http://localhost:8080,http://localhost:8081

# Pepper (chave HMAC) dos hashes de identificadores banidos (email/documento).
# OBRIGATÓRIO em produção: sem ele, ou com menos de 32 caracteres, a API não arranca.
# NUNCA mudar depois de haver banimentos (invalida os hashes). Tem de estar no .env que a
# API realmente lê: artifacts/api-server/.env. Placeholder apenas; nunca commitar o valor real.
BAN_HASH_PEPPER=

# ------------------------------------------------------------------------------
# SERVIDOR & APLICAÇÃO
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
BASE_PATH=/
V I D E O _ T R A N S C O D E _ C R F = 2 3  

# ------------------------------------------------------------------------------
# LIVE STREAMING / OVENMEDIAENGINE
# ------------------------------------------------------------------------------
# Segredo partilhado entre a VPS do OvenMediaEngine e o backend da Xclusive.
# O OME envia este segredo no header HTTP (ex: X-Webhook-Secret) para autorizar
# o início/término de publicações RTMP no endpoint POST /api/live/admission.
LIVE_ADMISSION_SECRET=xclusive_live_admission_secret_example_change_in_production

# Segredo que assina os tokens de espectador WebRTC (vida de 90 s) devolvidos por
# GET /api/live/:id/playback e validados no /api/live/admission (outgoing/webrtc).
# Mínimo 32 caracteres; diferente de SESSION_SECRET e LIVE_ADMISSION_SECRET.
# Se faltar, o WebRTC de espectadores fica desativado e o HLS continua a funcionar.
LIVE_VIEWER_TOKEN_SECRET=

# (Opcional) Base do URL de sinalização WebRTC dos espectadores.
# Por defeito: wss://live.xclusive.ao
LIVE_WEBRTC_VIEWER_BASE_URL=

# Interruptor do WebRTC dos espectadores (lido a cada pedido a GET /api/live/:id/playback).
#   off   (defeito, também se faltar ou for inválido): ninguém recebe o campo `webrtc` → só HLS.
#   admin : só admin e superadmin recebem `webrtc` (implantação gradual).
#   all   : todos. Só depois do upgrade da VPS e do teste de carga.
# Não há limite de espectadores por live nem no total (decisão de produto).
# Para mudar: editar o .env e reiniciar o PM2 (sem novo build do frontend).
LIVE_WEBRTC_VIEWER_MODE=

# Interruptor do HLS: true (defeito, nada muda) | false (só WebRTC). Com false o GET
# /api/live/:id/playback NÃO inclui o campo `streamKey` (só `webrtc`) e o frontend não usa o
# hls.js. Pré-requisitos antes de pôr false: LIVE_WEBRTC_VIEWER_MODE=all, LIVE_VIEWER_TOKEN_SECRET
# definido, admission do OME para webrtc, wss acessível e TcpRelay no OME (redes sem UDP).
# NOTA: isto não desliga o HLS na origem — desativar também os publishers HLS/LLHLS no OME
# (ou a pull zone do Bunny) para quem souber a streamKey. Editar o .env e reiniciar o PM2.
LIVE_HLS_ENABLED=

# Hostname da Pull Zone Bunny CDN para entrega LL-HLS do stream ao vivo
VITE_BUNNY_LIVE_CDN_HOSTNAME=xclusivelive.b-cdn.net
 

# ------------------------------------------------------------------------------
# DOCUMENTOS KYC (zona de armazenamento PRIVADA do Bunny)
# ------------------------------------------------------------------------------
# Storage Zone privada + Pull Zone própria com Token Authentication. Sem estas variáveis
# o envio de documentos KYC falha (nunca usa a zona pública). Nunca commitar valores.
BUNNY_PRIVATE_STORAGE_ZONE=
BUNNY_PRIVATE_STORAGE_KEY=
# Opcional: host regional da Storage Zone (defeito storage.bunnycdn.com)
BUNNY_PRIVATE_STORAGE_HOST=
# URL da Pull Zone privada (ex.: https://<nome>.b-cdn.net)
BUNNY_PRIVATE_CDN_URL=
# Chave de segurança (Token Authentication) da Pull Zone privada
BUNNY_PRIVATE_TOKEN_KEY=

# ------------------------------------------------------------------------------
# CDN PÚBLICO COM TOKEN AUTHENTICATION (avatares, capas, posts, reels, stories)
# ------------------------------------------------------------------------------
# Chave de segurança (URL Token Authentication) da Pull Zone PÚBLICA (BUNNY_CDN_HOSTNAME).
# Com ela definida, a API devolve URLs assinados de curta duração; sem ela, os URLs saem
# como antes. Nunca commitar valores.
BUNNY_CDN_TOKEN_KEY=

# ------------------------------------------------------------------------------
# CONTACTOS E EMAIL (sem valores reais; nunca commitar segredos)
# ------------------------------------------------------------------------------
# Contactos públicos. Sem eles a API usa legal@xclusive.ao (um só sítio: src/lib/contactos.ts).
# LEGAL_EMAIL: textos legais, encerramento de conta, levantamentos retidos, retirada de conteúdo.
# REPORTS_CONTACT_EMAIL: página de denúncias; sem ele usa o LEGAL_EMAIL.
# LEGAL_EMPRESA_NOME / LEGAL_EMPRESA_NIF / LEGAL_EMPRESA_SEDE: dados da empresa nos textos legais.
# LEGAL_EMAIL=
# REPORTS_CONTACT_EMAIL=
# LEGAL_EMPRESA_NOME=
# LEGAL_EMPRESA_NIF=
# LEGAL_EMPRESA_SEDE=

# Envio de email. POR DEFEITO DESLIGADO: sem EMAIL_TRANSPORTE=smtp a API nunca envia nada.
# Valores: smtp | desligado. Com smtp e configuração incompleta a API arranca na mesma e avisa (só nomes de variáveis).
EMAIL_TRANSPORTE=desligado
# Remetente, ex.: Xclusive <endereco@dominio> (a caixa tem de existir no fornecedor).
# EMAIL_REMETENTE=
# Para onde vão as respostas (opcional).
# EMAIL_RESPONDER_PARA=
# Base FIXA dos links dos emails (https://...). Nunca vem do cabeçalho Host.
# APP_URL_PUBLICO=
# Servidor SMTP do fornecedor. SMTP_SEGURO=true: TLS direto (porta 465); false: STARTTLS obrigatório (porta 587).
# SMTP_HOST=
# SMTP_PORTA=
# SMTP_SEGURO=
# SMTP_UTILIZADOR=
# SMTP_PALAVRA_PASSE=
