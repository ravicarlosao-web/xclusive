# ==============================================================================
# XCLUSIVE - Variáveis de Ambiente
# ==============================================================================

# ------------------------------------------------------------------------------
# BASE DE DADOS (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Cole aqui a connection string da sua branch do Neon (neon.tech)
# Exemplo: postgresql://neondb_owner:npg_xyz@ep-fancy-star-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-your-branch-id.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# AUTENTICAÇÃO E SEGURANÇA
# ------------------------------------------------------------------------------
SESSION_SECRET=xclusive_super_secret_jwt_key_local_dev_2026
ALLOWED_ORIGINS=http://localhost:19285,http://localhost:23744,http://localhost:8080,http://localhost:8081

# ------------------------------------------------------------------------------
# SERVIDOR & APLICAÇÃO
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
BASE_PATH=/
V I D E O _ T R A N S C O D E _ C R F = 2 3  

# ------------------------------------------------------------------------------
# LIVE STREAMING / OVENMEDIAENGINE
# ------------------------------------------------------------------------------
# Segredo partilhado entre a VPS do OvenMediaEngine e o backend da Xclusive.
# O OME envia este segredo no header HTTP (ex: X-Webhook-Secret) para autorizar
# o início/término de publicações RTMP no endpoint POST /api/live/admission.
LIVE_ADMISSION_SECRET=xclusive_live_admission_secret_example_change_in_production

# Segredo que assina os tokens de espectador WebRTC (vida de 90 s) devolvidos por
# GET /api/live/:id/playback e validados no /api/live/admission (outgoing/webrtc).
# Mínimo 32 caracteres; diferente de SESSION_SECRET e LIVE_ADMISSION_SECRET.
# Se faltar, o WebRTC de espectadores fica desativado e o HLS continua a funcionar.
LIVE_VIEWER_TOKEN_SECRET=

# (Opcional) Base do URL de sinalização WebRTC dos espectadores.
# Por defeito: wss://live.xclusive.ao
LIVE_WEBRTC_VIEWER_BASE_URL=

# Interruptor do WebRTC dos espectadores (lido a cada pedido a GET /api/live/:id/playback).
#   off   (defeito, também se faltar ou for inválido): ninguém recebe o campo `webrtc` → só HLS.
#   admin : só admin e superadmin recebem `webrtc` (implantação gradual).
#   all   : todos. Só depois do upgrade da VPS e do teste de carga.
# Para mudar: editar o .env e reiniciar o PM2 (sem novo build do frontend).
LIVE_WEBRTC_VIEWER_MODE=

# Limites de capacidade do WebRTC dos espectadores (modo "all"). O /playback só inclui o
# campo `webrtc` se houver vaga; senão o espectador recebe só { streamKey } e usa o HLS.
# admin e superadmin ignoram os limites. Inteiros ≥ 0 (0 = ninguém, exceto admin); se
# faltarem ou forem inválidos usam-se os defeitos. Um limite por live maior do que o
# total fica limitado pelo total. Lidos a cada pedido (editar o .env e reiniciar o PM2).
# ATENÇÃO: a contagem é feita pelas salas do socket.io e INCLUI os espectadores do HLS
# (a criadora e o próprio pedido ficam de fora). Por isso são valores CONSERVADORES, a
# rever depois do teste de carga. Só válido com uma instância do PM2 (fork).
#   defeito por live: 15      defeito total (todas as lives ativas): 30
LIVE_WEBRTC_MAX_VIEWERS_PER_LIVE=
LIVE_WEBRTC_MAX_VIEWERS_TOTAL=

# Hostname da Pull Zone Bunny CDN para entrega LL-HLS do stream ao vivo
VITE_BUNNY_LIVE_CDN_HOSTNAME=xclusivelive.b-cdn.net
 