# ==============================================================================
# XCLUSIVE - Variáveis de Ambiente
# ==============================================================================

# ------------------------------------------------------------------------------
# BASE DE DADOS (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Cole aqui a connection string da sua branch do Neon (neon.tech)
# Exemplo: postgresql://neondb_owner:npg_xyz@ep-fancy-star-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-your-branch-id.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# AUTENTICAÇÃO E SEGURANÇA
# ------------------------------------------------------------------------------
SESSION_SECRET=xclusive_super_secret_jwt_key_local_dev_2026
ALLOWED_ORIGINS=http://localhost:19285,http://localhost:23744,http://localhost:8080,http://localhost:8081

# ------------------------------------------------------------------------------
# SERVIDOR & APLICAÇÃO
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
BASE_PATH=/
V I D E O _ T R A N S C O D E _ C R F = 2 3  

# ------------------------------------------------------------------------------
# LIVE STREAMING / OVENMEDIAENGINE
# ------------------------------------------------------------------------------
# Segredo partilhado entre a VPS do OvenMediaEngine e o backend da Xclusive.
# O OME envia este segredo no header HTTP (ex: X-Webhook-Secret) para autorizar
# o início/término de publicações RTMP no endpoint POST /api/live/admission.
LIVE_ADMISSION_SECRET=xclusive_live_admission_secret_example_change_in_production

# Hostname da Pull Zone Bunny CDN para entrega LL-HLS do stream ao vivo
VITE_BUNNY_LIVE_CDN_HOSTNAME=xclusivelive.b-cdn.net
 