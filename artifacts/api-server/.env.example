
# AppyPay Integration
APPYPAY_CLIENT_ID=
APPYPAY_CLIENT_SECRET=
APPYPAY_BASE_URL=https://gwy-api-tst.appypay.co.ao/v2.0
APPYPAY_TOKEN_URL=https://login.microsoftonline.com/appypaydev.onmicrosoft.com/oauth2/token
APPYPAY_WEBHOOK_SECRET=
APPYPAY_WEBHOOK_URL=

# Banimentos: pepper (chave HMAC) dos hashes de email/documento banidos.
# OBRIGATÓRIO em produção (NODE_ENV=production): sem ele, ou com menos de 32 caracteres, a API não arranca.
# Mínimo 32 caracteres aleatórios (ex.: openssl rand -hex 32). NUNCA mudar depois de haver banimentos:
# invalida todos os hashes guardados e as contas banidas deixam de ser reconhecidas.
# Tem de estar no .env que a API realmente lê: artifacts/api-server/.env. Nunca commitar o valor real.
BAN_HASH_PEPPER=

# ------------------------------------------------------------------------------
# CONTACTOS E EMAIL (sem valores reais; nunca commitar segredos)
# ------------------------------------------------------------------------------
# Contactos públicos. Sem eles a API usa legal@xclusive.ao (um só sítio: src/lib/contactos.ts).
# LEGAL_EMAIL: textos legais, encerramento de conta, levantamentos retidos, retirada de conteúdo.
# REPORTS_CONTACT_EMAIL: página de denúncias; sem ele usa o LEGAL_EMAIL.
# LEGAL_EMPRESA_NOME / LEGAL_EMPRESA_NIF / LEGAL_EMPRESA_SEDE: dados da empresa nos textos legais.
# LEGAL_EMAIL=
# REPORTS_CONTACT_EMAIL=
# LEGAL_EMPRESA_NOME=
# LEGAL_EMPRESA_NIF=
# LEGAL_EMPRESA_SEDE=

# Envio de email. POR DEFEITO DESLIGADO: sem EMAIL_TRANSPORTE=smtp a API nunca envia nada.
# Valores: smtp | desligado. Com smtp e configuração incompleta a API arranca na mesma e avisa (só nomes de variáveis).
EMAIL_TRANSPORTE=desligado
# Remetente, ex.: Xclusive <endereco@dominio> (a caixa tem de existir no fornecedor).
# EMAIL_REMETENTE=
# Para onde vão as respostas (opcional).
# EMAIL_RESPONDER_PARA=
# Base FIXA dos links dos emails (https://...). Nunca vem do cabeçalho Host.
# APP_URL_PUBLICO=
# Servidor SMTP do fornecedor. SMTP_SEGURO=true: TLS direto (porta 465); false: STARTTLS obrigatório (porta 587).
# SMTP_HOST=
# SMTP_PORTA=
# SMTP_SEGURO=
# SMTP_UTILIZADOR=
# SMTP_PALAVRA_PASSE=
